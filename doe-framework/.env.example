# DOE Framework - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ============================================================
# GOOGLE
# ============================================================

# Google Ads API
# Get credentials at: https://developers.google.com/google-ads/api/docs/get-started/oauth-cloud-project
GOOGLE_ADS_CLIENT_ID=your_client_id_here
GOOGLE_ADS_CLIENT_SECRET=your_client_secret_here
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token_here
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here
GOOGLE_ADS_CUSTOMER_ID=[YOUR_GOOGLE_ADS_ACCOUNT_ID]   # e.g. 123-456-7890 (your primary account)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=[YOUR_MCC_ID]             # e.g. 999-888-7777 (your MCC/manager account, if applicable)

# Google Search Console API (uses same OAuth credentials as Google Ads, or service account)
# Service account JSON key path (alternative to OAuth)
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account.json

# GA4 Data API
GA4_PROPERTY_ID=[YOUR_GA4_PROPERTY_ID]   # e.g. 123456789 (numeric property ID from GA4 admin)

# ============================================================
# HUBSPOT
# ============================================================

# HubSpot Private App token
# Create at: https://app.hubspot.com/private-apps
# Required scopes: crm.objects.contacts.read, crm.objects.companies.read, crm.objects.deals.read, timeline
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# ============================================================
# LINKEDIN
# ============================================================

# LinkedIn Marketing API OAuth
# Create app at: https://www.linkedin.com/developers/apps
# Required scopes: r_ads, r_ads_reporting, r_organization_social, rw_organization_admin
LINKEDIN_CLIENT_ID=[YOUR_LINKEDIN_CLIENT_ID]           # e.g. your_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_REFRESH_TOKEN=your_linkedin_refresh_token_here
LINKEDIN_ACCOUNT_ID=[YOUR_LINKEDIN_ACCOUNT_ID]         # e.g. 123456789 (numeric ad account ID)

# ============================================================
# META / FACEBOOK
# ============================================================

# Meta Marketing API
# Create app at: https://developers.facebook.com/apps
# Required permissions: ads_read, ads_management, leads_retrieval
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_meta_long_lived_access_token_here
META_AD_ACCOUNT_ID=[YOUR_META_AD_ACCOUNT_ID]           # e.g. act_1234567890123456

# ============================================================
# CALENDLY
# ============================================================

# Calendly API
# Get token at: https://calendly.com/integrations/api_webhooks
CALENDLY_API_TOKEN=your_calendly_api_token_here

# ============================================================
# APIFY
# ============================================================

# Apify API token
# Get token at: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# ============================================================
# ANTHROPIC (CLAUDE API)
# ============================================================

# Anthropic API key
# Get key at: https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model selection for analysis calls
# Recommended defaults (update as new models release):
#   Fast/balanced: claude-sonnet-4-6 (most section analysis calls)
#   High reasoning: claude-opus-4-7 (cross-vertical summary and executive summary)
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
ANTHROPIC_MODEL_EXECUTIVE=claude-opus-4-7

# ============================================================
# SLACK
# ============================================================

# Slack Bot Token (for file upload via files.upload API)
# Create bot at: https://api.slack.com/apps
# Required scopes: files:write, chat:write
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here

# Slack Incoming Webhook URL (fallback - cannot upload files, text-only delivery)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack channel to post in (e.g. #marketing-ops, #growth-intel, etc.)
SLACK_CHANNEL=[YOUR_SLACK_CHANNEL]

# ============================================================
# LANGFUSE (Observability + Evals)
# ============================================================

# Sign up at https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US)
# Go to Project Settings → API Keys to generate your key pair
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here

# Set to your region:
#   US: https://us.cloud.langfuse.com
#   EU: https://cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com
